{
  "name": "pdf-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private, local-only PDF editor by Dramane Bako",
  "author": {
    "name": "D.Bako",
    "url": "https://github.com/bakodramane"
  },
  "homepage": "https://github.com/bakodramane/pdf_manager",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder --win portable nsis",
    "assets": "node scripts/copy-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "pretest": "npm run assets"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "docx": "9.16.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "exceljs": "4.4.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wait-on": "9.5.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
