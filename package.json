{
  "name": "pdf-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private, local-only PDF editor by Dramane Bako",
  "author": {
    "name": "D.Bako",
    "url": "https://github.com/bakodramane"
  },
  "homepage": "https://github.com/bakodramane/pdf_manager",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder --win portable nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "10.0.3",
    "docx": "9.5.1",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "exceljs": "4.4.0",
    "jsdom": "25.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wait-on": "9.0.10"
  }
}
